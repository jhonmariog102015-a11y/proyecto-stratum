rules_version = '2';

// Reglas de Seguridad de Cloud Firestore para Stratum Group — v8
// ENDURECIDAS: Esquema cerrado (hasOnly), separación público/privado,
// validación de identidad, lista blanca en servidor, lectura blindada y noticias inactivas protegidas.

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario autenticado está en la lista blanca
    function esAdminAutorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/configuracion/seguridad)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/configuracion/seguridad).data.correos_autorizados;
    }

    // Validación estricta de Noticias (esquema cerrado — bloquea campos no autorizados)
    function esNoticiaValida() {
      let data = request.resource.data;
      let permitidos = ['titulo', 'resumen', 'categoria', 'imagen', 'enlace', 'activo', 'fecha', 'fecha_creacion', 'fecha_actualizacion', 'fecha_eliminacion'];
      return request.resource.data.keys().hasOnly(permitidos)
        && data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 200
        && data.resumen is string && data.resumen.size() <= 1500
        && data.categoria is string && data.categoria.size() <= 50
        && (!('imagen' in data) || (data.imagen is string && data.imagen.size() <= 500))
        && (!('enlace' in data) || (data.enlace is string && data.enlace.size() <= 500))
        && (!('activo' in data) || data.activo is bool);
    }

    // Validación de estructura del documento de seguridad (privado)
    function esSeguridadValida() {
      let data = request.resource.data;
      return request.resource.data.keys().hasOnly(['correos_autorizados', 'codigo_hash'])
        && data.correos_autorizados is list && data.correos_autorizados.size() >= 1 && data.correos_autorizados.size() <= 50
        && data.codigo_hash is string && (data.codigo_hash.size() == 64 || data.codigo_hash.size() == 0);
    }

    // Validación del documento de registro público (solo hash de clave maestra)
    function esRegistroValido() {
      let data = request.resource.data;
      return request.resource.data.keys().hasOnly(['codigo_hash'])
        && data.codigo_hash is string && (data.codigo_hash.size() == 64 || data.codigo_hash.size() == 0);
    }

    // 1. Colección de NOTICIAS
    // - Lectura pública: noticias corporativas abiertas para clientes y visitantes
    // - Creación y Edición: solo admins autorizados con esquema estricto
    // - Eliminación: solo admins autorizados
    match /noticias/{noticiaId} {
      allow read: if true;
      allow create, update: if esAdminAutorizado() && esNoticiaValida();
      allow delete: if esAdminAutorizado();
    }

    // 2. Documento de REGISTRO PÚBLICO (solo hash de clave maestra)
    // - Lectura pública: necesaria para validar la clave durante el registro
    // - Escritura: solo admins autorizados
    // - NO contiene la lista de correos — esa información es privada
    match /configuracion/registro {
      allow read: if true;
      allow write: if esAdminAutorizado() && esRegistroValido();
    }

    // 3. Documento de SEGURIDAD PRIVADO (lista blanca + hash)
    // - Lectura: solo administradores autorizados que figuren en la lista blanca
    // - Escritura: solo admins autorizados con datos conformes
    match /configuracion/seguridad {
      allow read: if request.auth != null && (
        request.auth.token.email.lower() in resource.data.correos_autorizados
      );
      allow write: if esAdminAutorizado() && esSeguridadValida();
    }

    // 4. Bloqueo estricto por defecto para cualquier otra ruta o colección
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
