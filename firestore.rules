rules_version = '2';

// Reglas de Seguridad de Cloud Firestore para Stratum Group
// ENDURECIDAS: Validación de identidad, lista blanca en servidor y validación de esquema de datos.

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario autenticado está en la lista blanca
    function esAdminAutorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/configuracion/seguridad)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/configuracion/seguridad).data.correos_autorizados;
    }

    // Validación de campos y tamaño de Noticias para evitar inyecciones masivas o corrupción de datos
    function esNoticiaValida() {
      let data = request.resource.data;
      return data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 200
        && data.resumen is string && data.resumen.size() <= 1500
        && data.categoria is string && data.categoria.size() <= 50;
    }

    // Validación de estructura para el documento de seguridad
    function esSeguridadValida() {
      let data = request.resource.data;
      return data.correos_autorizados is list && data.correos_autorizados.size() <= 50
        && data.codigo_hash is string && (data.codigo_hash.size() == 64 || data.codigo_hash.size() == 0);
    }

    // 1. Colección de NOTICIAS
    // - Lectura pública para la página web
    // - Creación y Edición: solo admins autorizados con datos válidos
    // - Eliminación: solo admins autorizados
    match /noticias/{noticiaId} {
      allow read: if true;
      allow create, update: if esAdminAutorizado() && esNoticiaValida();
      allow delete: if esAdminAutorizado();
    }

    // 2. Colección de CONFIGURACIÓN DE SEGURIDAD (Lista blanca y clave maestra)
    // - Lectura pública requerida para que el formulario de registro valide la autorización previa
    // - Escritura: solo admins autorizados con datos conformes
    match /configuracion/seguridad {
      allow read: if true;
      allow write: if esAdminAutorizado() && esSeguridadValida();
    }

    // 3. Bloqueo estricto por defecto para cualquier otra ruta o colección
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
