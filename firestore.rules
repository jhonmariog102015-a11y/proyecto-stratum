rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo un operador con acceso IAM puede conceder acceso a un UID.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    function esNoticiaValida() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'titulo', 'resumen', 'categoria', 'activo', 'fecha_creacion',
          'imagen', 'enlace', 'fecha', 'fecha_actualizacion', 'fecha_eliminacion',
          'autor', 'createdAt', 'updatedAt', 'borrador'
        ])
        && data.keys().hasAll(['titulo', 'resumen', 'categoria', 'activo', 'fecha_creacion'])
        && data.titulo is string && data.titulo.size() >= 2 && data.titulo.size() <= 300
        && data.resumen is string && data.resumen.size() <= 20000
        && data.categoria is string && data.categoria.size() >= 1 && data.categoria.size() <= 100
        && data.activo is bool
        // Un borrador nunca está publicado.
        && (!('borrador' in data) || (data.borrador is bool && !(data.borrador && data.activo)))
        && data.fecha_creacion is timestamp
        && (!('imagen' in data) || (data.imagen is string && data.imagen.size() <= 3000))
        && (!('enlace' in data) || (data.enlace is string && data.enlace.size() <= 2000))
        && (!('fecha' in data) || (data.fecha is string && data.fecha.size() <= 100))
        && (!('autor' in data) || (data.autor is string && data.autor.size() <= 100))
        && (!('fecha_actualizacion' in data) || data.fecha_actualizacion is timestamp)
        && (!('fecha_eliminacion' in data) || data.fecha_eliminacion is timestamp)
        // Campos de fechas de versiones anteriores del panel.
        && (!('createdAt' in data) || data.createdAt is timestamp
            || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || data.updatedAt is timestamp
            || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /noticias/{noticiaId} {
      allow get: if esAdmin() || resource.data.activo == true;
      allow list: if esAdmin() || (request.query.limit <= 20 && resource.data.activo == true);
      allow create, update: if esAdmin() && esNoticiaValida();
    }

    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // El cliente nunca puede escribir permisos ni consultar la configuración antigua.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
