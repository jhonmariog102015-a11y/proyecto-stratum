rules_version = '2';

// Reglas de Seguridad de Cloud Firestore para Stratum Group
// Diseñadas para proteger la base de datos contra accesos no autorizados.

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Colección de NOTICIAS
    // - Lectura pública: cualquier visitante puede ver las noticias en noticias.html
    // - Escritura protegida: solo usuarios autenticados (administradores con sesión activa) pueden crear o borrar noticias.
    match /noticias/{noticiaId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // 2. Colección de CONFIGURACIÓN DE SEGURIDAD (Lista blanca y clave maestra)
    // - Lectura: necesaria para verificar la lista blanca antes de registrar una cuenta.
    // - Escritura protegida: solo administradores autenticados pueden agregar correos a la lista blanca o rotar la clave maestra.
    match /configuracion/seguridad {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Bloqueo por defecto para cualquier otra colección o documento no especificado
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
