{
  "name": "proyecto-stratum",
  "version": "3.0.0",
  "description": "Portal corporativo y sistema administrativo de noticias para Stratum Group S.A.S. - Ingeniería Minera y Consultoría",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/build-hosting.mjs",
    "dev": "npm run build && node scripts/emuladores.mjs",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "test:rules": "node scripts/emuladores.mjs --test-rules",
    "test:ui": "npm run build && node scripts/emuladores.mjs --test-ui"
  },
  "keywords": [
    "stratum-group",
    "ingenieria-minera",
    "consultoria",
    "geologia",
    "colombia",
    "firebase"
  ],
  "author": "Stratum Group S.A.S.",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0",
    "playwright-core": "1.65.1"
  },
  "overrides": {
    "@firebase/firestore": { "@grpc/grpc-js": "1.14.7" }
  },
  "engines": {
    "node": ">=22"
  }
}
