{
  "name": "proyecto-stratum",
  "version": "3.0.0",
  "description": "Portal corporativo y sistema administrativo de noticias para Stratum Group S.A.S. - Ingeniería Minera y Consultoría",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/build-hosting.mjs",
    "dev": "npm run build && firebase emulators:start --project demo-stratum --only hosting",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stratum \"node --test tests/firestore-rules.test.mjs\""
  },
  "keywords": [
    "stratum-group",
    "ingenieria-minera",
    "consultoria",
    "geologia",
    "colombia",
    "firebase"
  ],
  "author": "Stratum Group S.A.S.",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "firebase-tools": "15.36.0"
  },
  "engines": {
    "node": ">=22"
  }
}
